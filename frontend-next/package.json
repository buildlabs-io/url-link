{
  "name": "url-link-frontend-next",
  "version": "1.0.0",
  "private": true,
  "author": "buildlabs-io",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "reinstall": "rm -rf .next pnpm-lock.yaml node_modules && pnpm i",
    "reinstall:full": "rm -rf pnpm-lock.yaml .next .turbo node_modules && pnpm store prune && pnpm i",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "dev": "next dev  --port 5555",
    "build": "next build",
    "start": "next start",
    "format": "npx prettier --write .",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "apexcharts": "8.0.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-apexcharts": "2.1.1",
    "react-dom": "19.3.0",
    "react-qr-code": "2.2.0",
    "sonner": "2.0.8",
    "swr": "2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all"
  ],
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0"
}
